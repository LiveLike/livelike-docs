            "required": false
          },
          {
            "in": "query",
            "name": "name",
            "schema": {
              "type": "string"
            },
            "description": "Name for AB test",
            "required": true
          },
          {
            "in": "query",
            "name": "description",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Description for AB Test"
          },
          {
            "in": "query",
            "name": "profile_group_ids",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
