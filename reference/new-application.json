          },
          {
            "in": "query",
            "name": "started_at",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "start time of quest in UTC"
          },
          {
            "in": "query",
            "name": "stopped_at",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "end time of quest in UTC"
          },
          {
            "in": "query",
            "name": "variants",
            "schema": {
              "type": "array",
              "items": {
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Variant name"
                  },
                  "badge_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "A list of badge UUIDs to be linked to a specific variant."
                  },
                  "quest_rewards": {
                    "type": "array",
                    "items": {
                      "properties": {
                        "reward_item_id": {
                          "type": "string",
                          "description": "uuid if reward item"
                        },
                        "reward_item_amount": {
                          "type": "integer",
                          "description": "amount value to be awarded "
                        }
                      },
                      "type": "object"
                    },
                    "description": "A list of reward objects to be associated with the quest variant."
                  },
                  "sponsor_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "UUIDs of sponsors that should be linked to the quest variant."
                  },
                  "quest_tasks": {
                    "type": "array",
                    "description": "A list of quest tasks to be associated with the variant for tracking and progressing the quest.",
                    "items": {
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "Display name of the quest task."
                        },
                        "target_value": {
                          "type": "string",
                          "description": "Required count or value to complete the task."
                        },
                        "quest_task_actions": {
                          "type": "array",
                          "items": {
                            "properties": {
                              "reward_action_key": {
                                "type": "string",
                                "description": "key of the action whose occurrence increments the task’s progress."
                              }
                            },
                            "type": "object"
                          },
                          "description": "List of actions that contribute toward progressing this task."
                        }
                      },
                      "type": "object"
                    }
                  }
                },
                "type": "object"
              }
            },
            "description": "Takes exactly two variant objects ",
            "style": "deepObject",
            "explode": true,
            "required": true
          },
          {
            "in": "query",
            "name": "timeout",
            "schema": {
              "type": "string"
            },
            "description": "Duration after the first user action within which the quest must be completed (used when started_at or stopped_at is not provided)"
          }
        ],
