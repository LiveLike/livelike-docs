                    "example": "Image Product"
                  },
                  "cost": {
                    "type": "number",
                    "example": "10.00"
                  },
                  "inventory_count": {
                    "type": "integer",
                    "example": "5"
                  },
                  "reward_item_id": {
                    "type": "string",
                    "example": "028a5d74-d587-45d5-a6e6-d802c75ba75c"
                  },
                  "image[0]image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "image[0]display_order": {
                    "type": "integer",
                    "example": "0"
                  },
                  "image[1]image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "image[1]display_order": {
                    "type": "integer",
                    "example": "1"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
